# Application
APP_ENV=development
DEMO_MODE=false
DATABASE_PATH=./data/ai_review.db
APP_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET
DEFAULT_TIMEZONE=Asia/Kolkata

# AI provider (select one and provide its API key)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# GitHub (optional for public repositories)
GITHUB_TOKEN=

# Gmail SMTP; use a Google App Password without spaces
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM_EMAIL=your-gmail-address@gmail.com
EMAIL_FROM=your-gmail-address@gmail.com
